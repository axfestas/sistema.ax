# Cloudflare D1 Database
# Configure no wrangler.toml ou no Cloudflare Dashboard
# DB binding é automático via wrangler.toml

# Node Version
NODE_VERSION=18

# Microsoft Graph API — Integração Word Online (Contratos)
# Configure as variáveis abaixo no Cloudflare Dashboard > Pages > Settings > Environment Variables
# Marque MS_CLIENT_SECRET como "Encrypted" (secret).
#
# Como obter:
#   1. Acesse https://portal.azure.com e crie um "App registration"
#   2. Em "API permissions" adicione: Files.ReadWrite.All (Application)
#   3. Gere um "Client secret" em "Certificates & secrets"
#   4. Conceda permissão de admin no tenant
#   5. Informe o e-mail/UPN do OneDrive que armazenará os contratos em MS_ONEDRIVE_USER
MS_CLIENT_ID=seu-client-id-aqui
MS_CLIENT_SECRET=seu-client-secret-aqui
MS_TENANT_ID=seu-tenant-id-aqui
MS_ONEDRIVE_USER=admin@suaempresa.com
